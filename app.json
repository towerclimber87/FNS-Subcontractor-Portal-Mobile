{
  "expo": {
    "name": "FNS Subcontractor Portal",
    "slug": "fns-subcontractor-portal",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#02070a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fouriernetworksolutions.fnssubcontractorportal",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "FNS Subcontractor Portal uses the camera to attach site photos and tracker photos.",
        "NSPhotoLibraryUsageDescription": "FNS Subcontractor Portal can attach selected photos to site records."
      }
    },
    "android": {
      "package": "com.fouriernetworksolutions.fnssubcontractorportal",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#02070a"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "FNS Subcontractor Portal can attach selected photos to site records.",
          "cameraPermission": "FNS Subcontractor Portal uses the camera to attach site photos and tracker photos."
        }
      ]
    ],
    "androidNavigationBar": {
      "backgroundColor": "#070b14",
      "barStyle": "light-content"
    }
  }
}
